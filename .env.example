# Copie para .env e ajuste. NUNCA versione o .env.
API_KEY=troque-por-uma-chave-forte
# Chave da API oficial (gratuita): https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Com ela, consultas por CPF/NIS usam a API oficial; sem ela, tudo vai pelo navegador.
PORTAL_API_KEY=
HEADLESS=true
MAX_CONCURRENT_BOTS=2
# Anti-CAPTCHA: intervalo entre o início dos robôs e novas tentativas após bloqueio (10s, 30s)
BOT_START_INTERVAL_S=3
ANTIBOT_MAX_RETRIES=2
ANTIBOT_RETRY_WAIT_S=10
NAVIGATION_TIMEOUT_MS=30000
SEARCH_TIMEOUT_MS=20000
TOTAL_TIMEOUT_S=120
SAVE_OUTPUT_FILES=true
OUTPUT_DIR=output
LOG_LEVEL=INFO
# Usado só por scripts\demo.ps1 (não é lido pela API)
ACTIVEPIECES_WEBHOOK_URL=
# Usado só por scripts\demo.ps1: NIS para o cenário "NIS existente"
DEMO_NIS=
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
